# ---------------------------------------------------------------------------
# HMAC keys for capability tokens (ordered keyring, zero-downtime rotation)
#
# CAPABILITY_KEYRING is an ORDERED comma-separated list of `kid:secret`
# entries. The FIRST entry signs every newly issued token (its kid is written
# into the signed payload); every entry can still verify tokens that carry
# its kid. Rotation is therefore:
#
#   1. generate a new secret and prepend "new-kid:<new-secret>";
#   2. (re)deploy — new tokens are signed with new-kid, old tokens keep
#      validating against the retired kid until they expire;
#   3. after CAPABILITY_MAX_TTL has passed, delete the retired entry —
#      tokens signed with it are rejected immediately (401 unknown_key).
#
# Constraints: kid = 1-128 chars from [A-Za-z0-9._-]; secrets must be
# non-empty (the secret may itself contain ':'; kids must be unique).
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
CAPABILITY_KEYRING=2026-09:dev-insecure-key-2026-09-change-me-0123456789,2026-01:dev-insecure-key-2026-01-change-me-0123456789

# Legacy verification key for tokens issued BEFORE keyring support, whose
# payload contains no "kid". Such tokens are checked against THIS KEY ONLY —
# the keyring is never searched by trying each key. Leave empty to reject all
# kid-less tokens. Tokens carrying an unknown kid are always rejected.
CAPABILITY_LEGACY_SECRET=dev-insecure-legacy-secret-change-me-0123456789

# Deprecated single-key mode: when CAPABILITY_KEYRING is empty, this value
# becomes the signing key (kid "default") AND the legacy key. Must NOT be set
# together with CAPABILITY_KEYRING (startup fails on the conflict).
CAPABILITY_SECRET=

# Optional shared key required by POST /tokens/issue (header X-Issuer-Key).
# Leave empty to leave issuance unauthenticated (useful for local experiments).
CAPABILITY_ISSUER_KEY=

# Shared key required by the admin endpoints POST /tokens/revoke-subject and
# GET /tokens/revocations (header X-Admin-Key). When empty those endpoints
# are disabled and answer 503 (fail closed).
CAPABILITY_ADMIN_KEY=dev-insecure-admin-key-change-me-0123456789

# Storage locations (inside the container these are mounted volumes).
CAPABILITY_DB_PATH=/data/capabilities.db
CAPABILITY_FILES_DIR=/app/files

# Token lifetimes in seconds.
CAPABILITY_DEFAULT_TTL=300
CAPABILITY_MAX_TTL=3600
